# OpenAI key for lesson wording; leave empty to keep lessons in English
LLM_API_KEY=
# OpenAI chat model id; required when LLM_API_KEY is set
LLM_MODEL=
# Optional: request timeout in seconds (default 20) and API base URL
# LLM_TIMEOUT_SECONDS=20
# LLM_BASE_URL=https://api.openai.com/v1
# Optional: reasoning effort for reasoning models; low keeps rewrites fast
# LLM_REASONING_EFFORT=low
WHISPER_API_KEY=
TTS_API_KEY=
API_BASE_URL=
# SQLite file for profiles and quizzes (relative to api/)
DATABASE_PATH=kompass.db
# Optional: override where the baseline quiz question bank is read from
# QUESTION_BANK_DIR=../data/question_bank
# Optional: override where base lessons and Findex data are read from
# LESSON_TEMPLATES_DIR=../data/lesson_templates
# FINDEX_DIR=../data/findex
# Local only: serve the lesson tester at /dev/lesson-tester
# DEV_TOOLS_ENABLED=true
