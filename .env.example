# API settings. Copy to api/.env (the API reads .env from the folder it runs in).
LLM_API_KEY=
WHISPER_API_KEY=
TTS_API_KEY=
API_BASE_URL=
# SQLite file for profiles and quizzes (relative to api/)
DATABASE_PATH=kompass.db
# Optional: override where the baseline quiz question bank is read from
# QUESTION_BANK_DIR=../data/question_bank

# Voice (see docs/DEPLOYMENT.md for every option)
# WHISPER_MODEL=whisper-1
# TTS_LANGUAGES=["en","es","sw"]
# VOICE_PROVIDER_TIMEOUT_SECONDS=20
# Local development only: labeled fixture transcript when WHISPER_API_KEY is empty
# VOICE_DEV_FIXTURES=true
# Browser origins for Expo web only, e.g. ["http://localhost:8081"]
# CORS_ALLOW_ORIGINS=[]

# App setting. Put this in app/.env; it is bundled into the app, so never a key.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
