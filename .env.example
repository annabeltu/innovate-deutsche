LLM_API_KEY=
# Gemini key for speech-to-text and Swahili read-aloud (API only, never in the app)
GEMINI_API_KEY=
# Optional: override the model fallback order (JSON lists), e.g.
# GEMINI_TRANSCRIBE_MODELS='["gemini-3.5-transcribe","gemini-3.5-flash-lite"]'
# GEMINI_TTS_MODELS='["gemini-3.8-flash-tts","gemini-2.5-flash-preview-tts"]'
API_BASE_URL=
# SQLite file for profiles and quizzes (relative to api/)
DATABASE_PATH=kompass.db
# Optional: override where the baseline quiz question bank is read from
# QUESTION_BANK_DIR=../data/question_bank

# App API URL; use your computer LAN address for a physical phone
EXPO_PUBLIC_API_URL=http://localhost:8000
