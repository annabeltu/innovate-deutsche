# OpenAI key for lesson wording; leave empty to keep lessons in English
# API settings. Copy to api/.env (the API reads .env from the folder it runs in).
LLM_API_KEY=
# OpenAI chat model id; required when LLM_API_KEY is set
LLM_MODEL=
# Optional: request timeout in seconds (default 20) and API base URL
# LLM_TIMEOUT_SECONDS=20
# LLM_BASE_URL=https://api.openai.com/v1
# Optional: reasoning effort for reasoning models; low keeps rewrites fast
# LLM_REASONING_EFFORT=low
WHISPER_API_KEY=
TTS_API_KEY=
API_BASE_URL=
# SQLite file for profiles and quizzes (relative to api/)
DATABASE_PATH=kompass.db
# Optional: override where the baseline quiz question bank is read from
# QUESTION_BANK_DIR=../data/question_bank
# Optional: override where base lessons and Findex data are read from
# LESSON_TEMPLATES_DIR=../data/lesson_templates
# FINDEX_DIR=../data/findex
# Browser origins allowed to call the API (JSON list); defaults to Expo web on :8081
# CORS_ALLOWED_ORIGINS=["http://localhost:8081"]
# Local only: serve the lesson tester at /dev/lesson-tester
# DEV_TOOLS_ENABLED=true

# Expo app API URL (set in app/.env; use LAN address for a phone)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Voice (see docs/DEPLOYMENT.md for every option)
# WHISPER_MODEL=whisper-1
# TTS_LANGUAGES=["en","es","sw"]
# VOICE_PROVIDER_TIMEOUT_SECONDS=20
# Local development only: labeled fixture transcript when WHISPER_API_KEY is empty
# VOICE_DEV_FIXTURES=true
# Browser origins for Expo web only, e.g. ["http://localhost:8081"]
# CORS_ALLOW_ORIGINS=[]

# App setting. Put this in app/.env; it is bundled into the app, so never a key.
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
